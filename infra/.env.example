# Copie para infra/.env (ignorado pelo Git) antes de usar o profile "apps".
# Segredo HS256 compartilhado por Auth, Catalog, Orders e Payments (mínimo 32 caracteres).
JWT_SECRET=replace-this-with-a-long-random-secret-of-32-chars-or-more
JWT_EXPIRES_IN=1h
PAYMENT_APPROVAL_LIMIT=5000

# Administrador inicial criado pelo Auth Service (usado pelo painel admin e pelo smoke test).
ADMIN_EMAIL=admin@shopmesh.local
ADMIN_PASSWORD=change-me-admin-password

# Portas publicadas no host (altere se já estiverem em uso).
POSTGRES_PORT=5432
MONGO_PORT=27017

# Tracing distribuído (ligue junto com o profile "observability").
TRACING_ENABLED=false
